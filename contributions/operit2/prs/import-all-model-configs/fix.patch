-                "contextLength".to_string(),
-                "summaryCustomRules".to_string(),
-                "enableGoogleSearch".to_string(),
-                "enableClaude1hPromptCache".to_string(),
-            ],
+            importedModelCount: providers.iter().map(|provider| provider.models.len() as i32).sum(),
+            chatBindingUpdated,
+            skippedFields,
         })
     }
 
