+#[allow(non_snake_case)]
+fn insertOperit1UserDocumentIfEmpty(
+    documents: &mut BTreeMap<String, String>,
+    id: &str,
+    markdown: String,
+) {
+    if documents.get(id).map_or(true, |current| current.trim().is_empty()) {
+        documents.insert(id.to_string(), markdown);
+    }
 }
 
