diff --git a/hosts/android/src/terminal.rs b/hosts/android/src/terminal.rs
--- a/hosts/android/src/terminal.rs
+++ b/hosts/android/src/terminal.rs
@@ -856,10 +856,15 @@
             buffer = result.0;
         }
